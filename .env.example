# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (Neon, Supabase, Vercel Postgres, or local docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextshop?schema=public"
# Direct (non-pooled) connection for migrations. Same as DATABASE_URL locally;
# on Neon, use the host without "-pooler".
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nextshop?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Needed when not on Vercel (e.g. local production build, Docker)
AUTH_TRUST_HOST=true

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (optional — emails are logged to console when unset)
RESEND_API_KEY=""
EMAIL_FROM="Store <orders@yourdomain.com>"

# Public settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="NextShop"
NEXT_PUBLIC_CURRENCY="USD"

# Used by `npm run db:seed` to create the first admin
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
